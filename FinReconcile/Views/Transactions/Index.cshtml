@model IEnumerable<FinReconcile.Models.InternalTransaction>

@{
    ViewData["Title"] = "Lançamentos Internos";
    var totalAmount = Model.Sum(x => x.Amount);
    var pendingCount = Model.Count(x => x.Status == FinReconcile.Models.TransactionStatus.Pending);
    var reconciledCount = Model.Count(x => x.Status == FinReconcile.Models.TransactionStatus.Reconciled);
}

<div class="d-flex justify-content-between align-items-end mb-4">
    <div>
        <h1 class="h4 fw-bold mb-1">Livro-Razão Interno</h1>
        <p class="text-muted small mb-0">Lançamentos operacionais registrados no sistema para conferência de liquidação</p>
    </div>
    <a asp-controller="Reconciliation" asp-action="Upload" class="btn btn-primary px-3 shadow-sm">
        <i class="bi bi-upload me-1"></i> Importar Extrato
    </a>
</div>

<!-- Metrics Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="metric-card">
            <span class="metric-header">Volume Total Registrado</span>
            <span class="metric-body mono-num text-dark">@totalAmount.ToString("C")</span>
        </div>
    </div>
    <div class="col-md-4">
        <div class="metric-card">
            <span class="metric-header">Aguardando Conciliação</span>
            <span class="metric-body mono-num text-warning">@pendingCount</span>
        </div>
    </div>
    <div class="col-md-4">
        <div class="metric-card">
            <span class="metric-header">Liquidações Confirmadas</span>
            <span class="metric-body mono-num text-success">@reconciledCount</span>
        </div>
    </div>
</div>

<!-- Table Card -->
<div class="card-panel">
    <div class="card-panel-header">
        <span class="fw-semibold">Transações do Período</span>
        <span class="text-muted small mono-num">@Model.Count() registros</span>
    </div>
    <div class="table-responsive">
        <table class="table-fintech">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Documento / Referência</th>
                    <th>Data do Evento</th>
                    <th class="text-end">Valor Esperado</th>
                    <th class="text-center">Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="text-muted mono-num">#@item.Id</td>
                        <td class="fw-semibold">@item.ExternalReference</td>
                        <td class="text-muted mono-num">@item.TransactionDate.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="text-end fw-bold mono-num">@item.Amount.ToString("C")</td>
                        <td class="text-center">
                            @switch (item.Status)
                            {
                                case FinReconcile.Models.TransactionStatus.Pending:
                                    <span class="status-pill pill-pending">
                                        <i class="bi bi-clock"></i> Pendente
                                    </span>
                                    break;
                                case FinReconcile.Models.TransactionStatus.Reconciled:
                                    <span class="status-pill pill-reconciled">
                                        <i class="bi bi-check2-circle"></i> Conciliado
                                    </span>
                                    break;
                                case FinReconcile.Models.TransactionStatus.Divergent:
                                    <span class="status-pill pill-divergent">
                                        <i class="bi bi-exclamation-octagon"></i> Divergente
                                    </span>
                                    break;
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>