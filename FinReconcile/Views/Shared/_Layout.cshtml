<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FinReconcile</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-container">
        <!-- Sidebar -->
        <aside class="sidebar">
            <div class="brand-section">
                <div class="brand-logo">
                    <i class="bi bi-layers-half"></i>
                </div>
                <span>FinReconcile</span>
            </div>

            <ul class="nav-menu">
                <li>
                    <a class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Transactions" ? "active" : "")" 
                       asp-controller="Transactions" asp-action="Index">
                        <i class="bi bi-book"></i>
                        <span>Lançamentos</span>
                    </a>
                </li>
                <li>
                    <a class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "Upload" ? "active" : "")" 
                       asp-controller="Reconciliation" asp-action="Upload">
                        <i class="bi bi-arrow-left-right"></i>
                        <span>Matches & Extratos</span>
                    </a>
                </li>
                <li>
                    <a class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "Divergences" ? "active" : "")" 
                       asp-controller="Reconciliation" asp-action="Divergences">
                        <i class="bi bi-shield-exclamation"></i>
                        <span>Divergências</span>
                    </a>
                </li>
            </ul>

            <div class="sidebar-footer">
                <div class="engine-pulse"></div>
                <span>Motor Conectado (Docker SQL)</span>
            </div>
        </aside>

        <!-- Main Area -->
        <div class="main-viewport">
            <header class="topbar-minimal">
                <div class="text-muted small fw-medium">
                    Plataforma de Auditoria e Fechamento Contábil
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-light text-secondary border px-2 py-1 small">Ambiente Dev</span>
                </div>
            </header>

            <main class="page-wrapper">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>