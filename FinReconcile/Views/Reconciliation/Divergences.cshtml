@model FinReconcile.Models.DivergenceViewModel

@{
    ViewData["Title"] = "Fila de Divergências";
}

<!-- SECTION: Page Header -->
<header class="d-flex justify-content-between align-items-end mb-4">
    <div>
        <h1 class="h4 fw-bold mb-1">Mesa de Divergências</h1>
        <p class="text-muted small mb-0">Itens não correspondidos automaticamente aguardando conciliação manual</p>
    </div>
    <a asp-action="Upload" class="btn btn-outline-secondary px-3" aria-label="Voltar para a tela de Upload">
        <i class="bi bi-arrow-left-right me-1" aria-hidden="true"></i> Ver Matches
    </a>
</header>

<!-- SECTION: Alerts & Notifications -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success border-0 shadow-sm d-flex align-items-center mb-4" role="alert" aria-live="polite">
        <i class="bi bi-check-circle-fill me-2 fs-5" aria-hidden="true"></i>
        <div>@TempData["Success"]</div>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger border-0 shadow-sm d-flex align-items-center mb-4" role="alert" aria-live="assertive">
        <i class="bi bi-exclamation-triangle-fill me-2 fs-5" aria-hidden="true"></i>
        <div>@TempData["Error"]</div>
    </div>
}

<!-- SECTION: Manual Match Form -->
<section class="card-panel mb-4 p-4" aria-labelledby="manual-match-title">
    <h2 id="manual-match-title" class="fw-semibold mb-3 h5">Vincular Transação e Extrato Manualmente</h2>
    
    <form asp-action="ManualReconcile" method="post" class="row g-3 align-items-end">
        <div class="col-md-4">
            <label for="internalTransactionId" class="form-label small text-muted text-uppercase fw-semibold">1. Lançamento Pendente</label>
            <select id="internalTransactionId" name="internalTransactionId" class="form-select" required>
                <option value="">Selecione o lançamento...</option>
                @foreach (var tx in Model.UnmatchedInternalTransactions)
                {
                    <option value="@tx.Id">#@tx.Id - @tx.ExternalReference (@tx.Amount.ToString("C"))</option>
                }
            </select>
        </div>
        
        <div class="col-md-4">
            <label for="bankStatementId" class="form-label small text-muted text-uppercase fw-semibold">2. Extrato Bancário</label>
            <select id="bankStatementId" name="bankStatementId" class="form-select" required>
                <option value="">Selecione o extrato...</option>
                @foreach (var st in Model.UnmatchedBankStatements)
                {
                    <option value="@st.Id">#@st.Id - @st.OriginalReference (Líq: @st.NetAmount.ToString("C"))</option>
                }
            </select>
        </div>
        
        <div class="col-md-3">
            <label for="note" class="form-label small text-muted text-uppercase fw-semibold">3. Justificativa</label>
            <input type="text" id="note" name="note" class="form-control" placeholder="Ex: Ajuste de spread aprovado" />
        </div>
        
        <div class="col-md-1 d-grid">
            <button type="submit" class="btn btn-success" aria-label="Confirmar conciliação manual">
                <i class="bi bi-link-45deg" aria-hidden="true"></i>
            </button>
        </div>
    </form>
</section>

<!-- SECTION: Comparison Grid -->
<section class="row g-4">
    <!-- Internal Transactions -->
    <div class="col-lg-6">
        <div class="card-panel h-100">
            <header class="card-panel-header">
                <h3 class="fw-semibold text-danger m-0 h6">Lançamentos Internos Pendentes</h3>
                <span class="badge bg-danger bg-opacity-10 text-danger mono-num" aria-label="Total de lançamentos pendentes">
                    @Model.UnmatchedInternalTransactions.Count
                </span>
            </header>
            <div class="table-responsive">
                <table class="table-fintech" aria-label="Tabela de lançamentos internos pendentes">
                    <thead>
                        <tr>
                            <th scope="col">ID</th>
                            <th scope="col">Referência</th>
                            <th scope="col">Data</th>
                            <th scope="col" class="text-end">Valor</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.UnmatchedInternalTransactions.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">Nenhum item pendente.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model.UnmatchedInternalTransactions)
                            {
                                <tr>
                                    <td class="text-muted mono-num">#@item.Id</td>
                                    <td class="fw-semibold">@item.ExternalReference</td>
                                    <td class="text-muted mono-num">@item.TransactionDate.ToString("dd/MM/yyyy")</td>
                                    <td class="text-end fw-bold mono-num">@item.Amount.ToString("C")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Bank Statements -->
    <div class="col-lg-6">
        <div class="card-panel h-100">
            <header class="card-panel-header">
                <h3 class="fw-semibold text-danger m-0 h6">Extratos sem Correspondência</h3>
                <span class="badge bg-danger bg-opacity-10 text-danger mono-num" aria-label="Total de extratos sem correspondência">
                    @Model.UnmatchedBankStatements.Count
                </span>
            </header>
            <div class="table-responsive">
                <table class="table-fintech" aria-label="Tabela de extratos bancários sem correspondência">
                    <thead>
                        <tr>
                            <th scope="col">ID</th>
                            <th scope="col">Referência Extrato</th>
                            <th scope="col">Data</th>
                            <th scope="col" class="text-end">Valor Líquido</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.UnmatchedBankStatements.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">Nenhum extrato divergente.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model.UnmatchedBankStatements)
                            {
                                <tr>
                                    <td class="text-muted mono-num">#@item.Id</td>
                                    <td class="fw-semibold">@item.OriginalReference</td>
                                    <td class="text-muted mono-num">@item.StatementDate.ToString("dd/MM/yyyy")</td>
                                    <td class="text-end fw-bold mono-num text-primary">@item.NetAmount.ToString("C")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>