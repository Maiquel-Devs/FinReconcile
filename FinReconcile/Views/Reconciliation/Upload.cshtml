@model IEnumerable<FinReconcile.Models.ReconciliationMatch>

@{
    ViewData["Title"] = "Importação e Matches";
}

<!-- SECTION: Page Header -->
<header class="d-flex justify-content-between align-items-end mb-4">
    <div>
        <h1 class="h4 fw-bold mb-1">Processamento de Extratos</h1>
        <p class="text-muted small mb-0">Importação de arquivos CSV bancários e execução automática de regras de liquidação</p>
    </div>
    <a asp-action="Divergences" class="btn btn-outline-secondary px-3" aria-label="Acessar fila de divergências">
        <i class="bi bi-shield-exclamation me-1" aria-hidden="true"></i> Fila de Divergências
    </a>
</header>

<!-- SECTION: Alerts & Notifications -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success border-0 shadow-sm d-flex align-items-center mb-4" role="alert" aria-live="polite">
        <i class="bi bi-check-circle-fill me-2 fs-5" aria-hidden="true"></i>
        <div>@TempData["Success"]</div>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger border-0 shadow-sm d-flex align-items-center mb-4" role="alert" aria-live="assertive">
        <i class="bi bi-exclamation-triangle-fill me-2 fs-5" aria-hidden="true"></i>
        <div>@TempData["Error"]</div>
    </div>
}

<!-- SECTION: Upload Form -->
<section class="card-panel mb-4 p-4" aria-label="Área de upload de extrato bancário">
    <form asp-action="Upload" method="post" enctype="multipart/form-data" class="row g-3 align-items-center">
        <div class="col-md-9">
            <label for="file" class="form-label fw-semibold small text-muted text-uppercase mb-1">Arquivo de Extrato (.CSV)</label>
            <input type="file" id="file" name="file" class="form-control" accept=".csv" required aria-required="true" />
        </div>
        <div class="col-md-3 d-grid">
            <label class="form-label d-none d-md-block" aria-hidden="true">&nbsp;</label>
            <button type="submit" class="btn btn-primary" aria-label="Processar arquivo enviado">
                <i class="bi bi-cpu me-1" aria-hidden="true"></i> Processar Arquivo
            </button>
        </div>
    </form>
</section>

<!-- SECTION: Matches Table -->
<section class="card-panel" aria-labelledby="matches-title">
    <header class="card-panel-header">
        <h2 id="matches-title" class="fw-semibold h6 m-0">Auditoria de Matches Confirmados</h2>
        <span class="text-muted small mono-num" aria-label="Total de conciliações">
            @Model.Count() conciliações
        </span>
    </header>
    <div class="table-responsive">
        <table class="table-fintech" aria-label="Tabela de auditoria das transações conciliadas">
            <thead>
                <tr>
                    <th scope="col">Data Conciliação</th>
                    <th scope="col">Ref. Interna</th>
                    <th scope="col">Ref. Extrato</th>
                    <th scope="col" class="text-end">Esperado</th>
                    <th scope="col" class="text-end">Líquido Banco</th>
                    <th scope="col" class="text-center">Tipo de Match</th>
                    <th scope="col">Nota / Justificativa</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">
                            Nenhum match realizado até o momento. Importe um extrato CSV acima.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var match in Model)
                    {
                        <tr>
                            <td class="text-muted mono-num">@match.ReconciledAt.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="fw-semibold">@match.InternalTransaction.ExternalReference</td>
                            <td class="text-muted">@match.BankStatement.OriginalReference</td>
                            <td class="text-end mono-num">@match.InternalTransaction.Amount.ToString("C")</td>
                            <td class="text-end fw-bold mono-num text-success">@match.BankStatement.NetAmount.ToString("C")</td>
                            <td class="text-center">
                                @if (match.MatchType == FinReconcile.Models.MatchType.Exact)
                                {
                                    <span class="status-pill pill-reconciled">Exato</span>
                                }
                                else if (match.MatchType == FinReconcile.Models.MatchType.Tolerance)
                                {
                                    <span class="status-pill pill-tolerance">Tolerância (@match.DifferenceAmount.ToString("C"))</span>
                                }
                                else
                                {
                                    <span class="status-pill pill-pending">Manual</span>
                                }
                            </td>
                            <td class="text-muted small">@match.Note</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>